# Puerto del servidor (Render lo asigna automáticamente)
PORT=3001

# Entorno
NODE_ENV=development

# Firebase Service Account (JSON completo como string)
# En Render, pegar el JSON completo del service account
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5500

# Clave secreta para el endpoint de seed/admin (cambiar en producción)
ADMIN_SETUP_KEY=cambiar-esta-clave-en-produccion
